{
  // Cloudflare Workers config: serve the static site from ./site
  "name": "faa-fire-safety",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Workers Builds deploys non-production branches (pull requests) with
  // `wrangler preview`, which refuses to run without this block.
  "previews": {}
}
